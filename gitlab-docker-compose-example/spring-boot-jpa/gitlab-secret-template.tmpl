{
  "version": "15.0.0",
  "vulnerabilities": [
    {{range $i, $f := .}}{{if $i}},{{end}}{
      "id": "{{$f.Fingerprint}}",
      "category": "secret_detection",
      "name": "{{$f.Description}}",
      "description": "Secret detected: {{$f.RuleID}}",
      "severity": "Critical",
      "scanner": {
        "id": "betterleaks",
        "name": "Betterleaks"
      },
      "location": {
        "file": "{{$f.File}}",
        "commit": {
          "sha": "{{$f.Commit}}"
        },
        "start_line": {{$f.StartLine}}
      }
    }{{end}}
  ],
  "remediations": []
}

